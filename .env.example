# Copy to .env; never commit .env
# OpenAI-compatible chat completions endpoint (Ollama: http://127.0.0.1:11434/v1)
STUDENT_BASE_URL=http://127.0.0.1:11434/v1
STUDENT_API_KEY=
STUDENT_MODEL=qwen2.5-coder:7b
STUDENT_TIMEOUT_SECONDS=180
STUDENT_TEMPERATURE=0
# Optional teacher endpoint, reserved for future automatic planning:
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=
# Optional: use a remote Ollama server via Tailscale HTTPS/reverse proxy.
# Do NOT expose unauthenticated Ollama to the public internet.

# Unsloth Studio: Settings > API; use the exact loaded model ID
UNSLOTH_BASE_URL=http://127.0.0.1:8888/v1
UNSLOTH_API_KEY=
UNSLOTH_MODEL=

# RunPod REST API v2 lifecycle; credentials never committed
RUNPOD_API_KEY=
# Existing pod is preferred. When empty, --create-pod is required.
RUNPOD_POD_ID=
RUNPOD_MODEL=
RUNPOD_INFERENCE_API_KEY=
# Optional inference URL override (otherwise derived from Pod ID + port)
RUNPOD_INFERENCE_BASE_URL=
RUNPOD_INFERENCE_PORT=8000
RUNPOD_READY_TIMEOUT_SECONDS=600
RUNPOD_POLL_SECONDS=10

# Only for explicit --create-pod (billable!)
RUNPOD_GPU_TYPE=NVIDIA GeForce RTX 4090
RUNPOD_IMAGE=
RUNPOD_TEMPLATE_ID=
RUNPOD_POD_NAME=micro-agent-lab
RUNPOD_CLOUD_TYPE=SECURE
RUNPOD_CONTAINER_DISK_GB=30
RUNPOD_VOLUME_GB=30
RUNPOD_PORTS=8000/http
