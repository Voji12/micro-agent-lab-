# Copy to .env; never commit .env
# OpenAI-compatible chat completions endpoint (Ollama: http://127.0.0.1:11434/v1)
STUDENT_BASE_URL=http://127.0.0.1:11434/v1
STUDENT_API_KEY=
STUDENT_MODEL=qwen2.5-coder:7b
STUDENT_TIMEOUT_SECONDS=180
STUDENT_TEMPERATURE=0
# Optional teacher endpoint, reserved for future automatic planning:
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=
# Optional: use a remote Ollama server via Tailscale HTTPS/reverse proxy.
# Do NOT expose unauthenticated Ollama to the public internet.
